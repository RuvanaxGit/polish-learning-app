# Copy to .env and fill in the placeholders. Never commit .env.
# Only variables used by the current implementation phase are listed here.
# See README.md "Environment variables" for the full planned list.

# --- Local PostgreSQL (docker compose) ---
POSTGRES_USER=slowko
# Choose your own local password. Use URL-safe characters (letters, digits, - _ .)
# so it can be pasted into the URLs below unchanged.
POSTGRES_PASSWORD=password
POSTGRES_DB=slowko
POSTGRES_PORT=5432

# --- Application ---
# Use the same user/password/port as above.
DATABASE_URL=postgresql://slowko:password@localhost:5432/slowko
# Optional, default 10.
# DATABASE_POOL_MAX=10

# --- Authentication (Better Auth + Google) ---
# At least 32 random characters, e.g. the output of: openssl rand -base64 32
BETTER_AUTH_SECRET=random-secret
# Must match the origin you open in the browser.
BETTER_AUTH_URL=http://localhost:3000
# From Google Cloud Console > APIs & Services > Credentials (see README).
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-client-secret>
# Comma-separated emails allowed to sign up. Seeded into allowed_emails at startup
# (insert-only; removing an email here does not revoke access, see docs/operations.sql).
ALLOWED_EMAILS=you@example.com

# --- Tests (integration + e2e) ---
# Must point to a database whose name ends in _test. The compose init script
# creates <POSTGRES_DB>_test on first start.
TEST_DATABASE_URL=postgresql://slowko:password@localhost:5432/slowko_test
# Test-only session seeding. Leave false; the e2e runner sets it for its own server.
E2E_AUTH_BYPASS=false
